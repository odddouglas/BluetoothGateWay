<t-divider content="监测面板" />
<t-cell title="温度" arrow>
    <view slot="note" class="cell-note-bold">
        {{mqtt_on_off_line&&ble_on_off_line ? temperature : 'outofdate'}}
    </view>
</t-cell>
<t-cell title="湿度" arrow>
    <view slot="note" class="cell-note-bold">
        {{mqtt_on_off_line&&ble_on_off_line  ? humidity : 'outofdate'}}
    </view>
</t-cell>
<t-cell title="LED" arrow>
    <view slot="note" class="cell-note-bold">
        {{mqtt_on_off_line&&ble_on_off_line  ? led : 'outofdate'}}
    </view>
</t-cell>
<t-divider content="控制面板" />
<!-- <t-cell title="LED">
    <t-switch bindchange="handleChange1" value="{{led_on_off}}" label="{{['开', '关']}}" slot="note" />
</t-cell>
<t-cell title="BLE">
    <t-switch bindchange="handleChange2" value="{{ble_on_off}}" label="{{['开', '关']}}" slot="note" />
</t-cell> -->
<wxs module="_">
module.exports.contain = function(arr, key) {return arr.indexOf(key) > -1};
module.exports.getLabel = function(index) {return "LED" + (index + 1);};
</wxs>
<t-checkbox-group t-class="horizontal-box" value="{{checkbox_val}}" bind:change="handleChange4">
    <view wx:for="{{4}}" wx:key="index" class="card {{_.contain(checkbox_val, index) ? 'card--active' : ''}}">
        <t-icon wx:if="{{_.contain(checkbox_val, index)}}" name="check" t-class="card__icon" ariaHidden="{{true}}" />
        <t-checkbox value="{{index}}" label="{{_.getLabel(index)}}" icon="none" borderless />
    </view>
</t-checkbox-group>
<view class="button-example">
    <t-button bindtap="handleButton2" theme="default" block size="large" t-class="group-btn">
        下发命令
    </t-button>
</view>
<t-divider content="设备情况" />
<t-cell bindtap="handleCell1" title="网关" hover note="{{mqtt_on_off_line ? mqttStatus : ''}}" arrow />
<t-cell bindtap="handleCell2" title="节点" hover note="{{mqtt_on_off_line ? bleStatus : ''}}" arrow />
<view class="button-example">
    <t-button bindtap="handleButton1" theme="{{buttonTheme}}" block size="large" t-class="group-btn">
        {{buttonText}}
    </t-button>
</view>
<view class="wrapper">
    <t-collapse value="{{collapse_val}}" bind:change="handleChange3">
        <t-collapse-panel header="连接说明" value="{{0}}" expandIcon>
            <view>- 网关设备与平台之间的连接断开1分钟后(数据自动刷新周期为1分钟)置为“离线”状态。</view>
            <view>- 网关在线可以实时显示(网关设备上电)，但是离线需要等待一分钟(网关设备断电)。</view>
            <view>- 节点在线离线均可以实时显示(节点设备上电断电)，但是要确保网关设备一直连接云平台。</view>
            <view>- 设备不在线时，仅可显示设备离线前最后一次数据</view>
        </t-collapse-panel>
    </t-collapse>
</view>